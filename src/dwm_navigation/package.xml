<?xml version="1.0"?>
<package format="3">
  <name>dwm_navigation</name>
  <version>0.2.0</version>
  <description>Lidar mapping, odometry and waypoint navigation bridge.</description>
  <maintainer email="rayanalamsiam2000@gmail.com">Rayan-01</maintainer>
  <url type="repository">https://github.com/Rayan-01/dwm-robot</url>
  <license>LicenseRef-Proprietary</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>dwm_core</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
